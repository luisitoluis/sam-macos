{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":configMigration"],
  "labels": ["renovatebot"],
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",
  "pinDigests": false,
  "packageRules": [
    {
      "description": "ratatui-image only builds against one ratatui release, so they must move together",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["ratatui", "ratatui-image", "crossterm"],
      "groupName": "ratatui"
    }
  ]
}
